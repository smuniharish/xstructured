# Example environment for xstructured development. xstructured itself reads no
# environment variables: behaviour is configured in code, per wrapper or
# middleware. Each variable below is read by the component named in its group
# heading. Never commit real credentials.

# Read by the examples (examples/_shared.py) and the live test suite
# (`uv run pytest -m live`). Without EXPLABS_API_KEY the examples replay a
# scripted model offline.
EXPLABS_API_KEY=
EXPLABS_BASE_URL=
EXPLABS_MODEL=

# Read by the OpenTelemetry SDK exporter in examples/opentelemetry_tracing.py,
# for example http://localhost:4318.
OTEL_EXPORTER_OTLP_ENDPOINT=
