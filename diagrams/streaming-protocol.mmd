sequenceDiagram
    participant U as Caller
    participant W as XStructuredRunnable
    participant R as Wrapped Runnable
    participant D as StreamDecoder

    U->>W: stream(input)
    W->>R: stream(prepared_input)
    loop each chunk
        R-->>W: text chunk
        W->>D: feed(chunk)
        D-->>U: TEXT_DELTA / STRUCTURED_START / STRUCTURED_DELTA / STRUCTURED_END
    end
    W->>D: finalize()
    D-->>U: trailing TEXT_DELTA (if any)
    W-->>U: RESULT (XStructuredResult)
