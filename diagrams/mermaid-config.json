{
  "theme": "base",
  "themeVariables": {
    "fontFamily": "Segoe UI, Helvetica Neue, Arial, sans-serif",
    "fontSize": "15px",
    "primaryColor": "#EEF2FF",
    "primaryTextColor": "#1E1B4B",
    "primaryBorderColor": "#4F46E5",
    "secondaryColor": "#ECFDF5",
    "tertiaryColor": "#F8FAFC",
    "lineColor": "#64748B",
    "clusterBkg": "#F8FAFC",
    "clusterBorder": "#CBD5E1",
    "edgeLabelBackground": "#FFFFFF",
    "actorBkg": "#EEF2FF",
    "actorBorder": "#4F46E5",
    "actorTextColor": "#1E1B4B",
    "actorLineColor": "#94A3B8",
    "signalColor": "#334155",
    "signalTextColor": "#1E293B",
    "labelBoxBkgColor": "#EEF2FF",
    "labelBoxBorderColor": "#4F46E5",
    "loopTextColor": "#1E1B4B",
    "noteBkgColor": "#FFF7ED",
    "noteBorderColor": "#F59E0B",
    "noteTextColor": "#7C2D12"
  },
  "flowchart": {
    "useMaxWidth": false,
    "curve": "basis",
    "minNodeWidth": 0,
    "wrappingWidth": 320,
    "padding": 14,
    "nodeSpacing": 40,
    "rankSpacing": 48,
    "diagramPadding": 12
  },
  "sequence": {
    "useMaxWidth": false,
    "mirrorActors": false,
    "width": 90,
    "actorMargin": 20,
    "messageMargin": 34,
    "boxMargin": 10,
    "noteMargin": 8,
    "diagramMarginX": 12,
    "diagramMarginY": 12
  }
}